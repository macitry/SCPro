# ==============================================================================
# SSH 配置示例（占位地址，不是真实机器）
#
# 刷新 Host 时的规则：
#   ~/.ssh/config 存在  -> 以它为准，并覆盖本目录下的 ssh_config
#   ~/.ssh/config 不存在 -> 用本文件初始化 ~/.ssh/config
#
# 所以这里只放演示用的 RFC 5737 文档地址（192.0.2.0/24），
# 真实的主机名、内网 IP、端口请写在你自己的 ~/.ssh/config 里。
# ==============================================================================

Host demo-ai
  HostName 192.0.2.10
  User robot
  Port 22

Host demo-mc
  HostName 192.0.2.11
  User robot
  Port 60081
